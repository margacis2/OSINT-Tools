<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Top App Bar / Browser Navigation Header -->
    <LinearLayout
        android:id="@+id/browserHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Back to App -->
        <ImageButton
            android:id="@+id/btnBrowserBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"/>

        <!-- Title & URL Domain Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBrowserTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Loading..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgSslLock"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="SSL Lock"
                    android:src="@drawable/ic_lock"/>

                <TextView
                    android:id="@+id/tvBrowserUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="@color/accent_secondary"
                    android:textSize="10sp"
                    tools:text="https://checkusernames.com"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Reload / Stop Button -->
        <ImageButton
            android:id="@+id/btnBrowserReloadStop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload / Stop"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_secondary"/>

        <!-- Desktop Mode Button (Preserved ID: wtpdesktop) -->
        <ImageButton
            android:id="@+id/wtpdesktop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Desktop Mode"
            android:padding="8dp"
            android:src="@drawable/ic_desktop"
            app:tint="@color/text_secondary"/>

        <!-- Download / Save as PDF Button (Preserved ID: wtpsave) -->
        <ImageButton
            android:id="@+id/wtpsave"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save PDF / Print"
            android:padding="8dp"
            android:src="@drawable/ic_download"
            app:tint="@color/text_secondary"/>

        <!-- Share URL Button -->
        <ImageButton
            android:id="@+id/btnBrowserShare"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share URL"
            android:padding="8dp"
            android:src="@drawable/ic_share"
            app:tint="@color/text_secondary"/>

        <!-- Open External Browser -->
        <ImageButton
            android:id="@+id/btnBrowserExternal"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open External"
            android:padding="8dp"
            android:src="@drawable/ic_open_in_browser"
            app:tint="@color/text_secondary"/>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/browserProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_secondary"
        android:visibility="gone"/>

    <!-- Bottom Stroke -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_card_stroke"/>

    <!-- Container for WebView & In-Page Error / Loading Views -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Modern WebView (Preserved ID: webview) -->
        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"/>

        <!-- Browser Loading Placeholder -->
        <LinearLayout
            android:id="@+id/browserLoadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="@color/accent_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Loading investigative source..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- In-Page Error & Offline Recovery State View -->
        <LinearLayout
            android:id="@+id/browserErrorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Error Icon"
                android:src="@drawable/ic_empty_search"
                app:tint="@color/accent_secondary"/>

            <TextView
                android:id="@+id/tvErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Unable to Load Page"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvErrorDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="The investigative website could not be reached. Please check your connection or open in an external browser."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrorRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_primary"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="#FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrorExternal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:text="Open External"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_open_in_browser"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/accent_secondary"
                    app:strokeColor="@color/bg_card_stroke"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Browser Bottom Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnWebBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="History Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_secondary"/>

        <ImageButton
            android:id="@+id/btnWebForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="History Forward"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_secondary"/>

        <ImageButton
            android:id="@+id/btnWebReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_secondary"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Desktop Mode Pill Indicator -->
        <TextView
            android:id="@+id/tvDesktopPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Mobile Mode"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
