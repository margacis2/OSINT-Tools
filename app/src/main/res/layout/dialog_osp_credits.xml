<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_category_badge"/>

    <!-- Header Row: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_rounded"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="GitHub Icon"
                android:src="@drawable/ic_github"
                app:tint="@color/accent_secondary"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="OSP &amp; Creator Attribution"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Honoring the open-source authors &amp; projects"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Subtitle Banner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_icon_rounded"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:text="Every open-source tool creator and repository maintainer retains full copyright and credit. Tap any card below to visit their official profile or repository."
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"/>

    <!-- Scrollable Creator Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:maxHeight="380dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/ospCreditsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOspCreditsClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/bg_secondary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/bg_card_stroke"
        app:strokeWidth="1dp"/>

</LinearLayout>
